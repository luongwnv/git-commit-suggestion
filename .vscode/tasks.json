{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "shell",
      "command": "./node_modules/.bin/tsc",
      "args": ["-p", "."],
      "options": {
        "env": {
          "PATH": "${env:HOME}/.nvm/versions/node/v22.22.1/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "npm: watch",
      "type": "shell",
      "command": "./node_modules/.bin/tsc",
      "args": ["-w", "-p", "."],
      "options": {
        "env": {
          "PATH": "${env:HOME}/.nvm/versions/node/v22.22.1/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}
