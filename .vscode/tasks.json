{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "process",
      "command": "${userHome}/.nvm/versions/node/v22.17.1/bin/node",
      "args": ["${workspaceFolder}/node_modules/typescript/bin/tsc", "-p", "."],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "npm: watch",
      "type": "process",
      "command": "${userHome}/.nvm/versions/node/v22.17.1/bin/node",
      "args": ["${workspaceFolder}/node_modules/typescript/bin/tsc", "-w", "-p", "."],
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}
